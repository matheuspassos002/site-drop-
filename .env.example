# ==========================================
# PAINEL ADMINISTRATIVO & FULFILLMENT
# ==========================================
# Senha de acesso ao painel de fulfillment (/admin)
ADMIN_SECRET_KEY=admin123

# Links dos fornecedores para recompra rápida no Mercado Livre
NEXT_PUBLIC_SUPPLIER_KIT_5_URL=https://lista.mercadolivre.com.br/kit-5-cuecas-boxer-microfibra
NEXT_PUBLIC_SUPPLIER_KIT_10_URL=https://lista.mercadolivre.com.br/kit-10-cuecas-boxer-microfibra

# Custos unitários de fornecedor por kit
SUPPLIER_COST_KIT_5=45.00
SUPPLIER_COST_KIT_10=69.99

# ==========================================
# APLICAÇÃO
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# CONFIGURAÇÃO DE GATEWAY DE PAGAMENTO
# ==========================================
# Provedor ativo: "simulator" | "mercadopago" | "stripe"
# Se as chaves abaixo não forem preenchidas, a aplicação opera
# automaticamente em MODO SIMULAÇÃO (Sandbox com aprovação garantida e PIX demonstrativo).
GATEWAY_PROVIDER=simulator

# MERCADO PAGO (https://www.mercadopago.com.br/developers/panel)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# STRIPE (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
